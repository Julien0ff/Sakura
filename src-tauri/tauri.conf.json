{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SAKURA",
  "version": "0.4.0",
  "identifier": "app.sakura.desktop",
  "build": {
    "frontendDist": "offline",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "sakura-site",
        "sakura-site-desktop",
        "offline-page"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "category": "Video",
    "shortDescription": "Catalogue et lecteur d’animes",
    "longDescription": "SAKURA : catalogue d’animes, lecteur sans publicité, suivi de visionnage, calendrier des sorties VF/VOSTFR et statut Discord."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sakura"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "sakura"
          ],
          "host": "auth",
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzODA4Q0I4QTNDMTY0QUYKUldTdlpNR2p1SXlBdzR1K3pGWkpnTi9qRFRYY3BYeWFPdzVBK2lhSWJHbUZ6ZVZvcmw2U2ZBUVcK",
      "endpoints": [
        "https://github.com/Julien0ff/Sakura/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
