{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sakura-site",
  "description": "The live SAKURA site may call the app's shared commands (desktop and mobile) — no other origin.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://sakura.thefoxy.me/*"
    ]
  },
  "permissions": [
    "core:event:default",
    "notification:default",
    "allow-take-pending-auth",
    "allow-open-external",
    "allow-app-version"
  ]
}
